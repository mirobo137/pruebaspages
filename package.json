    "build": "npm run content:sync && tsc -b && vite build && npm run test:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
