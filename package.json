    "test:danger-flow": "node scripts/verify-danger-flow.mjs",
    "test:defeat": "node scripts/verify-defeat-flow.mjs",
    "test:regression": "node scripts/verify-multiplatform-regression.mjs",
    "test": "npm run test:music-ingest && npm run test:music-contracts && npm run test:music-v2 && npm run test:theme && npm run test:progress && npm run test:event && npm run test:layout && npm run test:ads && npm run test:revive && npm run test:daily-cosmetic && npm run test:crazygames && npm run test:poki && npm run test:telemetry && npm run test:input-profile && npm run test:desktop-baseline && npm run test:render-resolution && npm run test:adaptive-performance && npm run test:travel-budget && npm run test:mouse-drag && npm run test:input-equity && npm run test:combo-focus && npm run test:reactive-audio && npm run test:danger-flow && npm run test:defeat && npm run test:regression",
