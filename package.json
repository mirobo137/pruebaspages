    "test:render-resolution": "node scripts/verify-render-resolution.mjs",
    "test:adaptive-performance": "node scripts/verify-adaptive-performance.mjs",
    "test:travel-budget": "node scripts/verify-travel-budget.mjs",
    "test:mouse-drag": "node scripts/verify-mouse-drag-policy.mjs",
    "test:input-equity": "node scripts/verify-input-equity.mjs",
    "test:combo-focus": "node scripts/verify-combo-focus.mjs",
