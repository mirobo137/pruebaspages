    "test:theme": "node scripts/verify-theme-resolution.mjs",
    "test:music-ingest": "node scripts/verify-suno-ingestion.mjs",
    "test:music-contracts": "node scripts/verify-music-contracts.mjs",
    "test:music-v2": "node scripts/verify-music-v2-playback.mjs",
    "test:progress": "node scripts/verify-progress-migration.mjs",
    "test:event": "node scripts/verify-weekly-event.mjs",
    "test:layout": "node scripts/verify-menu-layout.mjs",
    "test:ads": "node scripts/verify-rewarded-ads.mjs",
    "test:revive": "node scripts/verify-phase-revive.mjs",
    "test:daily-cosmetic": "node scripts/verify-daily-cosmetic.mjs",
    "test:crazygames": "node scripts/verify-crazygames-adapter.mjs",
    "test:poki": "node scripts/verify-poki-adapter.mjs",
