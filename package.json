{
  "name": "pixi-mobile-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "music:manifest": "node scripts/generate-music-manifest.mjs",
    "music:beatmaps": "node scripts/generate-default-beatmaps.mjs",
    "content:sync": "npm run music:manifest && npm run music:beatmaps",
    "test:theme": "node scripts/verify-theme-resolution.mjs",
    "test:progress": "node scripts/verify-progress-migration.mjs",
    "test:event": "node scripts/verify-weekly-event.mjs",
    "test:layout": "node scripts/verify-menu-layout.mjs",
    "test:ads": "node scripts/verify-rewarded-ads.mjs",
    "test:revive": "node scripts/verify-phase-revive.mjs",
    "test:daily-cosmetic": "node scripts/verify-daily-cosmetic.mjs",
    "test:crazygames": "node scripts/verify-crazygames-adapter.mjs",
    "test": "npm run test:theme && npm run test:progress && npm run test:event && npm run test:layout && npm run test:ads && npm run test:revive && npm run test:daily-cosmetic && npm run test:crazygames",
    "dev": "npm run content:sync && vite",
    "build": "npm run content:sync && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
