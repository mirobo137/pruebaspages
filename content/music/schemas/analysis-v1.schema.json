{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superflow.local/schemas/analysis-v1.schema.json",
  "title": "SUPERFLOW Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "audioHash",
    "analyzerVersion",
    "duration",
    "estimatedBpm",
    "bpm",
    "tempoSource",
    "beatOffset",
    "beatOffsetSource",
    "beats",
    "onsets",
    "energyFrames"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "trackId": { "$ref": "#/$defs/id" },
    "audioHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "analyzerVersion": { "type": "string", "minLength": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "estimatedBpm": { "type": "number", "minimum": 30, "maximum": 300 },
    "bpm": { "type": "number", "minimum": 30, "maximum": 300 },
    "tempoSource": { "enum": ["estimated", "tempo-hint", "override"] },
    "beatOffset": { "type": "number", "minimum": 0 },
    "beatOffsetSource": { "enum": ["estimated", "override"] },
    "beats": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "onsets": {
      "type": "array",
      "items": { "$ref": "#/$defs/onset" }
    },
    "onsetsByBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "mid", "high"],
      "properties": {
        "low": { "type": "array", "items": { "$ref": "#/$defs/onset" } },
        "mid": { "type": "array", "items": { "$ref": "#/$defs/onset" } },
        "high": { "type": "array", "items": { "$ref": "#/$defs/onset" } }
      }
    },
    "energyFrames": {
      "type": "array",
      "items": { "$ref": "#/$defs/energyFrame" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "onset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "strength"],
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "strength": { "$ref": "#/$defs/unit" }
      }
    },
    "energyFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "volume", "low", "mid", "high"],
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "volume": { "$ref": "#/$defs/unit" },
        "low": { "$ref": "#/$defs/unit" },
        "mid": { "$ref": "#/$defs/unit" },
        "high": { "$ref": "#/$defs/unit" }
      }
    }
  }
}
