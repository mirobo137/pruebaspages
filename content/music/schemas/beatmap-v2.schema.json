{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superflow.local/schemas/beatmap-v2.schema.json",
  "title": "SUPERFLOW Beatmap v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "difficulty",
    "duration",
    "audioMode",
    "generatorVersion",
    "analysisHash",
    "locked",
    "spatialModelVersion",
    "interactionContractVersion",
    "phases",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "trackId": { "$ref": "#/$defs/id" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "audioMode": { "enum": ["single", "loop"] },
    "loopDuration": { "type": "number", "exclusiveMinimum": 0 },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "analysisHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "locked": { "type": "boolean" },
    "spatialModelVersion": { "type": "string", "minLength": 1 },
    "interactionContractVersion": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "audioMode": { "const": "loop" } } },
      "then": { "required": ["loopDuration"] },
      "else": { "not": { "required": ["loopDuration"] } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startTime", "endTime"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "startTime": { "type": "number", "minimum": 0 },
        "endTime": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "time", "phaseId", "kind", "start"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "time": { "type": "number", "minimum": 0 },
        "phaseId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["tap", "drag"] },
        "start": { "$ref": "#/$defs/position" },
        "controls": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/position" }
        },
        "checkpoints": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/position" }
        },
        "end": { "$ref": "#/$defs/position" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "drag" } } },
          "then": { "required": ["end"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["controls"] },
                { "required": ["checkpoints"] },
                { "required": ["end"] }
              ]
            }
          }
        }
      ]
    }
  }
}
