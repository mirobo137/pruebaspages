{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superflow.local/schemas/track-metadata-v1.schema.json",
  "title": "SUPERFLOW Track Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "title",
    "status",
    "audioMode",
    "webAudioPath",
    "audioHash",
    "rhythm",
    "suggestedSections",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "trackId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["legacy-active", "candidate", "active", "retired"] },
    "audioMode": { "enum": ["single", "loop"] },
    "webAudioPath": { "type": "string", "pattern": "^\\./assets/audio/" },
    "audioHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "loopDuration": { "type": "number", "exclusiveMinimum": 0 },
    "rhythm": { "$ref": "#/$defs/rhythm" },
    "suggestedSections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": { "properties": { "audioMode": { "const": "loop" } } },
      "then": { "required": ["loopDuration"] },
      "else": { "not": { "required": ["loopDuration"] } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullableNumber": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempoHint", "bpmOverride", "beatOffsetOverride"],
      "properties": {
        "tempoHint": { "$ref": "#/$defs/nullableNumber" },
        "bpmOverride": { "$ref": "#/$defs/nullableNumber" },
        "beatOffsetOverride": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startTime", "endTime"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "startTime": { "type": "number", "minimum": 0 },
        "endTime": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "provider",
        "commercialUseStatus",
        "privateEvidenceRef"
      ],
      "properties": {
        "sourceType": { "enum": ["ai-generated", "original-recording", "licensed", "legacy-unknown"] },
        "provider": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "commercialUseStatus": { "enum": ["verified", "evidence-required", "review-required"] },
        "privateEvidenceRef": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
